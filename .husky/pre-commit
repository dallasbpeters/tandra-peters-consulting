#!/bin/sh

PATH="node_modules/.bin:$PATH"

./node_modules/.bin/vitest run

# Check if there are any staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# Run formatters, capturing the exit code so we can still re-stage and report
FORMAT_EXIT_CODE=0
./node_modules/.bin/biome check --write . || FORMAT_EXIT_CODE=$?
./node_modules/.bin/oxfmt . || FORMAT_EXIT_CODE=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -Af -- "$file" || exit 1
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Formatting checks found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "Files formatted by local checks"

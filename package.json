  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@remotion/cli": "4.0.485",
    "@remotion/google-fonts": "4.0.485",

{
  "name": "react-example",
  "version": "0.0.0",
  "private": true,
  "description": "Fal-backed image upscaler and desktop wrapper for Tandra Peters Consulting.",
  "author": "Dallas Peters",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "copy:model-viewer": "node scripts/copy-model-viewer.mjs",
    "generate:theme-css": "tsx scripts/generate-theme-css-vars.mjs",
    "dev": "vite --port=3001 --host=0.0.0.0",
    "dev:all": "node scripts/stop-dev-servers.mjs && concurrently -k -n site,studio,email -c cyan,magenta,yellow \"pnpm dev\" \"pnpm --dir studio-tandra-peters dev\" \"pnpm --dir react-email-starter dev\"",
    "dev:studio": "pnpm --dir studio-tandra-peters dev",
    "dev:email": "pnpm --dir react-email-starter dev",
    "dev:tool": "node scripts/stop-dev-servers.mjs site,studio && concurrently -k -n site,studio -c cyan,magenta \"pnpm dev\" \"pnpm --dir studio-tandra-peters dev\"",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:content": "node scripts/stop-dev-servers.mjs studio,email && concurrently -k -n studio,email -c magenta,yellow \"pnpm --dir studio-tandra-peters dev\" \"pnpm --dir react-email-starter dev\"",
    "generate:desktop-icons": "node scripts/generate-desktop-icons.mjs",
    "prepare:desktop-env": "node scripts/prepare-desktop-env.mjs",
    "build": "node scripts/copy-model-viewer.mjs && tsx scripts/generate-theme-css-vars.mjs && vite build && tsx scripts/prerender.ts",
    "build:desktop": "node scripts/generate-desktop-icons.mjs && pnpm prepare:desktop-env && pnpm build && electron-builder",
    "build:desktop:dir": "node scripts/generate-desktop-icons.mjs && pnpm prepare:desktop-env && pnpm build && electron-builder --dir",
    "build:desktop:mac": "node scripts/generate-desktop-icons.mjs && pnpm prepare:desktop-env && pnpm build && electron-builder --mac",
    "build:desktop:mac:op": "APPLE_ID=op://Shared/RoleModel\\ Apple\\ Store/username APPLE_APP_SPECIFIC_PASSWORD=op://Shared/RoleModel\\ Apple\\ Store/password op run -- sh -c 'node scripts/generate-desktop-icons.mjs && pnpm prepare:desktop-env && pnpm build && electron-builder --mac'",
    "prerender": "tsx scripts/prerender.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "video:studio": "tsx scripts/render-tandra-intro.mjs studio",
    "generate-pwa-assets": "pwa-assets-generator",
    "video:sync-copy": "tsx scripts/sync-tandra-intro-copy.mjs",
    "video:still": "tsx scripts/render-tandra-intro.mjs still",
    "video:render": "tsx scripts/render-tandra-intro.mjs render",
    "video:snapshot": "node scripts/create-remotion-snapshot.mjs",
    "video:render:vercel": "node scripts/trigger-tandra-intro-render.mjs",
    "scaffold:sanity-component": "node scripts/scaffold-sanity-component.mjs",
    "lora:build": "node scripts/build-shingle-training-zip.mjs",
    "lora:train": "node scripts/train-txshingle-lora.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "stylelint": "stylelint \"**/*.{css,js}\"",
    "format": "exec prettier . --write",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit \"**/*.{css,js}\"",
    "check:types:fix": "tsc --noEmit --fix \"**/*.{css,js}\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "NODE_ENV=test vitest",
    "test:run": "NODE_ENV=test vitest run",
    "test:a11y": "NODE_ENV=test vitest run src/a11y",
    "check": "ultracite check",
    "fix": "biome check --write --unsafe",
    "prepare": "husky"
  },

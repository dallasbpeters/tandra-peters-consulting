  "build": {
    "appId": "com.tandra.falupscaler",
    "asar": true,
    "directories": {
      "buildResources": "electron/assets",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "icon": "app-icon.png",
    "linux": {
      "icon": "app-icon.png",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "productName": "Fal Upscaler",
    "win": {
      "target": [
        "nsis"
      ]
    }
  }

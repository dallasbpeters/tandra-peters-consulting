# Copy to `.env.local` (gitignored). Never commit real tokens.
#
# Create / rotate tokens: https://www.sanity.io/manage → Project → API → Tokens
# SANITY_API_WRITE_TOKEN — required for `pnpm seed` (loaded from this file automatically).
SANITY_API_WRITE_TOKEN=

# Presentation tool: must match the origin where the site runs (`pnpm dev` uses port 3001).
SANITY_STUDIO_PREVIEW_URL=http://localhost:3001

# Fal Image Studio: absolute URL to the site's generate endpoint.
# With `pnpm dev` (Vite port 3001), the repo serves /api/fal/generate-image when FAL_KEY is set at the repo root (.env.local).
SANITY_STUDIO_FAL_API_URL=http://localhost:3001/api/fal/generate-image

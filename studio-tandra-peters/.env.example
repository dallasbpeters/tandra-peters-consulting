# Copy to `.env.local` (gitignored). Never commit real tokens.
#
# Create / rotate tokens: https://www.sanity.io/manage → Project → API → Tokens
# SANITY_API_WRITE_TOKEN — required for `pnpm seed` (loaded from this file automatically).
SANITY_API_WRITE_TOKEN=

# Presentation tool: must match the origin where the site runs (`pnpm dev` uses port 3001).
# On Vercel (deployed studio): set to https://www.tandra.me
SANITY_STUDIO_PREVIEW_URL=http://localhost:3001

# Remotion video tool: base URL for the site that hosts /api/render-tandra-intro.
# Defaults to SANITY_STUDIO_PREVIEW_URL when unset.
# On Vercel (deployed studio): set to https://www.tandra.me
SANITY_STUDIO_RENDER_API_URL=http://localhost:3001

# Optional: Bearer secret for /api/render-tandra-intro (must match RENDER_VIDEO_SECRET in the site project).
# Required on Vercel so the deployed studio can authenticate render requests.
SANITY_STUDIO_RENDER_VIDEO_SECRET=

# Fal Image Studio: absolute URL to the site's generate endpoint.
# With `pnpm dev` (Vite port 3001), the repo serves /api/fal/generate-image when FAL_KEY is set at the repo root (.env.local).
SANITY_STUDIO_FAL_API_URL=http://localhost:3001/api/fal/generate-image

# Studio performance (local dev only — production always enables Presentation + Vision)
# Skip Presentation when editing in Structure only (no preview iframe). Much faster with `pnpm dev:studio`.
# SANITY_STUDIO_DISABLE_PRESENTATION=true
# Enable GROQ Vision tool in local dev (off by default — pulls in CodeMirror).
# SANITY_STUDIO_ENABLE_VISION=true

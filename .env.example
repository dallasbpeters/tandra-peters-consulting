# =============================================================================
# LOCAL — copy to `.env.local` at repo root (gitignored). Used by `pnpm dev` + Vite.
# =============================================================================

# Canonical site URL (no trailing slash). OG/Twitter meta, structured data, and social share links while developing locally (otherwise Facebook/LinkedIn get localhost and break).
# VITE_SITE_URL=https://www.tandra.me

# Contact form: production origin ONLY (e.g. https://www.tandra.me). Vite proxies only `/api/contact`.
# VITE_CONTACT_API_URL=https://www.tandra.me

# Elfsight Google Reviews widget UUID (class="elfsight-app-…").
# VITE_ELFSIGHT_WIDGET_ID=

# Sanity (public IDs are fine in the bundle; project/dataset are also in src/sanity/projectDetails.ts)
# Studio URL for stega “edit in Studio” links when not in Presentation iframe.
# VITE_SANITY_STUDIO_URL=http://localhost:3333
# Optional: force stega in the browser (normally only in Presentation iframe).
# VITE_SANITY_STEGA=true
# Viewer token — required so Presentation preview can read drafts (create in sanity.io/manage → API → Tokens).
# VITE_SANITY_API_READ_TOKEN=

# Mapbox GL (service area map on the home page)
# VITE_MAPBOX_ACCESS_TOKEN=

# Desk neighborhood + print-mail workflow.
# Austin map-level age/income data comes from City of Austin open data + Census Reporter.
# RENTCAST_API_KEY is only used server-side to match selected neighborhoods to property-level mailing recipients.
# RENTCAST_API_KEY=
# DIRECT_MAIL_PROVIDER=mock        # mock | lob | click2mail | postgrid | postalytics
# DIRECT_MAIL_SEND_ENABLED=false   # keep false until creative + recipients are reviewed
# LOB_API_KEY=
# LOB_FROM_ADDRESS_ID=
# CLICK2MAIL_USERNAME=
# CLICK2MAIL_PASSWORD=
# POSTGRID_API_KEY=
# POSTALYTICS_API_KEY=

# PostHog (public project key + ingestion host)
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Local capture is off by default to keep dev/Presentation light. Set true only when testing analytics.
# VITE_ENABLE_POSTHOG_DEV=false
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# First-party proxy example: https://t.tandra.me — set VITE_PUBLIC_POSTHOG_UI_HOST if toolbar/replay needs it.
# VITE_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Fal Image Studio: required for `pnpm dev` → POST /api/fal/generate-image (see plugins/viteFalDevApi.ts).
# Also set FAL_KEY on Vercel for the same route. Keep this server-side only; do not use SANITY_STUDIO_ or VITE_ prefixes.
# FAL_KEY=
# txshingle LoRA weights URL for Flux | txshingle LoRA in Image Studio (from training/txshingle-lora.json after pnpm lora:train).
# Local dev falls back to training/txshingle-lora.json when unset; set on Vercel for production Studio.
# FAL_TXSHINGLE_LORA_URL=

# =============================================================================
# STUDIO — `studio-tandra-peters/.env.local` (see studio-tandra-peters/.env.example)
# =============================================================================
# SANITY_API_WRITE_TOKEN — only for `pnpm seed` in the studio folder (never in Vite, never on Vercel unless you add server writes).
# SANITY_STUDIO_PREVIEW_URL — same origin/port as this app’s `pnpm dev` (port 3001).

# =============================================================================
# VERCEL — Project → Settings → Environment Variables
# =============================================================================

# Contact form → emails the lead to Tandra (api/contact.ts via Resend).
# RESEND_API_KEY=               # Resend API key (also used by the email composer).
# EMAIL_FROM="Tandra Peters <tandra@tandra.me>"   # Verified Resend sender.
# CONTACT_NOTIFICATION_TO=tandra@birdcreekroofing.com  # Optional; comma-separated. Defaults to tandra@birdcreekroofing.com.
# EMAIL_ASSET_BASE_URL=https://www.tandra.me           # Optional; base URL for the email logo.
# SANITY_WRITE_TOKEN — when set, contact-form submitters are saved to the Sanity
#   `emailContact` list (draft-only, deduped by email) so the email composer can
#   reach them. Same token used by Remotion render + composer "Save as default".
# SANITY_WRITE_TOKEN=

# ATTIO_API_TOKEN — optional second source for the composer's recipient list
# (merged with the Sanity contacts above, deduped by email; also logs sent notes).
# ATTIO_API_TOKEN=

# Agent Context — POST /api/agent (Groq LLM + Sanity Agent Context MCP).
# SANITY_API_READ_TOKEN — viewer token from sanity.io/manage → API → Tokens (or: npx sanity tokens add "Agent Context" --role=viewer --yes --json)
# SANITY_API_READ_TOKEN=
# GROQ_API_KEY — from console.groq.com
# GROQ_API_KEY=

# Agent MCP URL (default slug is content-editor; pass ?slug=... to /api/agent to override)
# SANITY_AGENT_CONTEXT_SLUG=content-editor

# Response agent — fetch Nextdoor thread text from shared links.
# Optional ops-only: server-side Nextdoor session for link fetches (Tandra uses screenshots instead).
# NEXTDOOR_SESSION_COOKIE=
# Optional Jina Reader API key for public-link extraction fallback.
# JINA_API_KEY=

# Optional Mobbin MCP for feature-agent UI reference search.
# If set, /api/feature-agent adds Mobbin tools with names prefixed `mobbin_`
# (e.g. `mobbin_search_screens`).
# MOBBIN_MCP_URL=
# MOBBIN_MCP_BEARER_TOKEN=

# Comma-separated exact Origins, e.g. https://www.tandra.me,http://localhost:3001
# ALLOWED_ORIGINS=

# Remotion on-demand render (POST /api/render-tandra-intro) — attach Vercel Blob first.
# BLOB_READ_WRITE_TOKEN=  # auto-injected when Blob store is linked to the project
# RENDER_VIDEO_SECRET=      # optional Bearer token for /api/render-tandra-intro
# SANITY_WRITE_TOKEN=       # saves renderedVideoUrl on homePage.tandraIntroVideo after render
# Trigger: pnpm video:render:vercel -- --url https://www.tandra.me

# Same VITE_* as above for production preview builds.
# VITE_SITE_URL=
# VITE_CONTACT_API_URL=
# VITE_ELFSIGHT_WIDGET_ID=
# VITE_GOOGLE_CLIENT_ID=
# Comma-separated allowlist (site auth gate + /seo and agent routes):
# VITE_GOOGLE_ALLOWED_EMAILS=you@example.com,teammate@example.com
# VITE_GOOGLE_ALLOWED_DOMAIN=example.com
# When true, sections wrapped in GoogleAuthGate require Google sign-in on the home page.
# VITE_GOOGLE_AUTH_GATE_ENABLED=false
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# VITE_ENABLE_POSTHOG_DEV=false
# VITE_PUBLIC_POSTHOG_HOST=
# VITE_PUBLIC_POSTHOG_UI_HOST=
# VITE_SANITY_STUDIO_URL=https://your-deployed-studio.sanity.studio

# SEO dashboard server analytics:
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=
# Optional app host for private PostHog API calls (defaults to us.posthog.com or is derived from VITE_PUBLIC_POSTHOG_HOST).
# POSTHOG_API_HOST=https://us.posthog.com
# Restrict dashboard routes (`/seo`, agents) to allowed Google accounts.
# Server (required for API auth): GOOGLE_ALLOWED_EMAILS / GOOGLE_ALLOWED_DOMAIN
# GOOGLE_ALLOWED_EMAILS=you@example.com,teammate@example.com
# GOOGLE_ALLOWED_DOMAIN=example.com
# Client (optional override for allowlist):
# VITE_GOOGLE_ALLOWED_EMAILS=you@example.com,teammate@example.com
# VITE_GOOGLE_ALLOWED_DOMAIN=example.com

# =============================================================================
# Notes
# =============================================================================
# - VITE_* are inlined at build time on Vercel.
# - RESEND_API_KEY, EMAIL_FROM, CONTACT_NOTIFICATION_TO, SANITY_WRITE_TOKEN, ATTIO_API_TOKEN, and ALLOWED_ORIGINS are server-only; never prefix with VITE_.
# - After rotating SANITY_API_WRITE_TOKEN, run from studio-tandra-peters: `pnpm seed`

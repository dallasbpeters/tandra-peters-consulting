{
  "include": [
    "src",
    "api",
    "server",
    "contactServiceOptions.ts",
    "vite.config.ts",
    "eslint.config.ts",
    "plugins/**/*.ts"
  ],
  "exclude": ["studio-tandra-peters", "dist", "node_modules"],
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@/components": ["./src/components"],
      "@/data": ["./src/data"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  }
}
